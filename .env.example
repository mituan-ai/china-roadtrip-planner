PORT=3000
HOST_PORT=3000
AMAP_JS_KEY=replace-with-domain-restricted-web-js-key
AMAP_JS_SECURITY_CODE=replace-with-web-js-security-code
AMAP_WEB_SERVICE_KEY=replace-with-server-only-web-service-key
DIRECTIONS_RATE_LIMIT=10
PLACES_RATE_LIMIT=30
WEATHER_RATE_LIMIT=20
AMAP_MAX_QUEUED_REQUESTS=100
# 仅在可信反向代理后设为 true
TRUST_PROXY=false
# 生产Compose覆盖文件使用
IMAGE=ghcr.io/mituan-ai/china-roadtrip-planner:latest
CADDY_NETWORK=caddy
